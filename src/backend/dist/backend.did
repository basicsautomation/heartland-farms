type GalleryItem = 
 record {
   category: GalleryCategory;
   id: nat;
   imageUrl: text;
   isVideo: opt bool;
   projectType: text;
   title: text;
   videoUrl: opt text;
 };
type GalleryCategory = 
 variant {
   dalMills;
   electricalPanels;
   flourMills;
   installationProjects;
   riceMills;
 };
type BlogPost = 
 record {
   author: text;
   category: text;
   content: text;
   date: int;
   excerpt: text;
   id: nat;
   readTime: text;
   slug: text;
   title: text;
 };
service : {
  getBlogPost: (slug: text) -> (opt BlogPost) query;
  getBlogPosts: () -> (vec BlogPost) query;
  getBlogPostsByCategory: (category: text) -> (vec BlogPost) query;
  getContactSubmissionCount: () -> (nat) query;
  getGalleryCategories: () -> (vec text) query;
  getGalleryItems: () -> (vec GalleryItem) query;
  getGalleryItemsByCategory: (category: GalleryCategory) ->
   (vec GalleryItem) query;
  submitContact: (name: text, company: text, phone: text, email: text,
   industry: text, message: text) -> (nat);
}
