import Types "../types";
import List "mo:core/List";
import Time "mo:core/Time";

module {
  public func seed(posts : List.List<Types.BlogPost>, nextId : Nat) : Nat {
    let now = Time.now();
    let samples : [(Text, Text, Text, Text, Text, Text)] = [
      (
        "PLC Programming for Rice Mills: A Complete Guide",
        "Discover how modern PLC programming transforms rice mill operations, reducing downtime by up to 40% while improving throughput and quality consistency across every processing stage.",
        "Programmable Logic Controllers (PLCs) have revolutionised rice mill operations across India. At Teja Controls, we have implemented PLC-based automation in over 150 rice mill projects, and the transformation in every facility has been remarkable.\n\nA conventional rice mill relies heavily on manual intervention at each processing stage: cleaning, milling, grading, and packaging. Every manual touchpoint introduces variability, human error, and operational risk. A PLC-based system eliminates this variability by executing precise, repeatable control sequences at each stage, 24 hours a day, seven days a week.\n\nFor the cleaning section, PLCs monitor vibration levels on destoners and aspirators in real time, automatically adjusting feed rates to maintain optimal separation efficiency. Paddy enters the cleaning section and the PLC coordinates the drum pre-cleaner, de-stoner, paddy separator, and aspirator in a tightly sequenced loop. If any machine trips, the upstream feed automatically stops within milliseconds, preventing material buildup and potential fire hazards.\n\nIn the milling section, whitener pressure and speed are controlled to a tolerance impossible to achieve manually. Our PLC programmes maintain whitener shaft speed within plus or minus two RPM, ensuring consistent milling intensity. This precision directly improves head rice yield — the percentage of whole grains that survive the milling process — which is the single most important quality metric for any rice miller.\n\nGrading conveyors benefit enormously from PLC integration through dynamic speed control based on output sensor feedback. Colour sorters and graders are interlocked so that no material passes to the next stage until the current stage confirms ready status. This prevents cross-contamination between grain grades and eliminates costly rework.\n\nThe packaging section achieves synchronised operation between filling, sealing, and conveyor systems. PLC-controlled weighing systems achieve gram-level accuracy across thousands of bags per shift, ensuring compliance with Legal Metrology Act requirements while virtually eliminating over-fill waste.\n\nData logging is built into every Teja Controls rice mill PLC system. Shift production reports, power consumption logs, and alarm histories are generated automatically. Mill managers can review yesterday's performance and identify bottlenecks before the morning shift briefing.\n\nOne of our clients in Andhra Pradesh reported a 38 percent reduction in power consumption after our PLC retrofit. Another client in Telangana saw head rice yield improve from 62 percent to 67 percent — a five-point improvement that, on a 10-tonne-per-hour mill, represents significant additional revenue every single day.\n\nThe investment in a comprehensive PLC automation system for a medium-sized rice mill typically ranges from fifteen to thirty lakh rupees depending on the scale and complexity of the installation. The payback period, based on our project portfolio, is consistently between fourteen and twenty-four months.\n\nTeja Controls provides complete PLC programming services including software design, panel manufacturing, site installation, commissioning, and operator training. Our engineers are certified on Siemens S7, Allen Bradley, Mitsubishi, and Delta PLC platforms, ensuring we can work with whatever hardware best suits your budget and supply chain.",
        "plc-programming-rice-mills",
        "automation",
        "8 min"
      ),
      (
        "SCADA Benefits for Food Processing Industries",
        "Learn how SCADA systems give food processing plant managers real-time visibility and control, transforming reactive maintenance into proactive plant management and cutting operational costs.",
        "Supervisory Control and Data Acquisition — SCADA — is the nervous system of any modern industrial facility. For food processing plants, SCADA is not a luxury. It is a competitive necessity that separates high-performing operations from those that struggle with downtime, waste, and compliance burdens.\n\nAt Teja Controls, our SCADA implementations for flour mills, dal mills, rice mills, and general food processing facilities share a common design philosophy: every sensor reading, every motor status, every alarm, and every production metric should be visible from a single screen, accessible from any device, archived for compliance, and actionable in real time.\n\nConsider a large flour mill operating multiple roller mill passages, purifiers, sifters, and bran finishers. Without SCADA, an operator must physically walk the length of the mill to assess system status. With our SCADA solution, all motor currents, bearing temperatures, product flow rates, silo levels, and pneumatic conveying pressures appear on a touch-screen HMI in the control room. Trends over the past eight hours are visible at a glance. Deviations from setpoint trigger alarms with colour coding and audible alerts before they become problems.\n\nEnergy monitoring is one of the most immediately valuable SCADA features for food processing facilities. Our systems integrate with smart energy meters on every major drive, providing kilowatt-hour consumption data per machine, per shift, and per tonne of product. Mill managers consistently discover that two or three machines account for a disproportionate share of energy cost — often due to worn bearings, misaligned drive belts, or incorrect setpoints. SCADA makes these inefficiencies visible and quantifiable.\n\nThe traceability benefit is increasingly important as food safety regulations tighten. The Food Safety and Standards Authority of India, FSSAI, requires food processors to maintain records of raw material intake, processing parameters, and finished product dispatch. Our SCADA systems log every process parameter with timestamp and batch ID, automatically generating the reports required for FSSAI inspections and export documentation.\n\nMaintenance scheduling is transformed by SCADA-driven asset management. Rather than replacing bearings on a fixed calendar schedule, our systems monitor motor current signatures and bearing temperatures to predict maintenance needs. This predictive approach reduces both unplanned breakdowns and unnecessary preventive maintenance costs.\n\nRemote access is standard on all our SCADA installations. Plant managers and engineers can monitor live process data and acknowledge alarms from a smartphone or laptop. Our Teja Controls support team can perform remote diagnostics, reducing the time and cost of emergency call-outs for many fault conditions.\n\nThe return on investment for a well-implemented SCADA system in a medium-sized flour mill is typically realised within eighteen months through energy savings, reduced waste, lower maintenance costs, and improved quality consistency. Larger facilities with complex multi-stage processes often achieve payback in under twelve months.",
        "scada-benefits-food-processing",
        "technology",
        "6 min"
      ),
      (
        "Maximizing ROI with Industrial Automation",
        "How do you justify the investment in industrial automation? This guide walks through a structured ROI calculation framework used by leading mill operators and food processors across India.",
        "The question every plant owner asks before approving an automation project is straightforward: when will I recover my investment? At Teja Controls, we have helped hundreds of clients in the rice milling, flour milling, dal processing, and food manufacturing sectors answer that question with rigour and confidence.\n\nThe ROI framework we apply considers four primary categories of measurable benefit: energy savings, labour optimisation, yield improvement, and maintenance cost reduction. Together these four categories typically account for eighty to ninety percent of the financial return from an automation investment.\n\nEnergy savings are frequently the largest category. Variable Frequency Drives, or VFDs, installed on major motors — aspirators, conveyors, fans, compressors — typically reduce power consumption by twenty to thirty-five percent. In a rice mill running sixteen hours a day, six days a week, the energy saving on just the main aspirator and conveyor system can exceed one lakh rupees per month, depending on electricity tariff and motor sizes. Our project data consistently shows this to be the fastest-payback element of any automation upgrade.\n\nLabour optimisation is the second major benefit category. A fully automated milling facility can typically operate with twenty to thirty percent fewer operators than a manually controlled plant of equivalent capacity. More importantly, the operators that remain shift from reactive fire-fighting roles to supervisory roles, improving morale, reducing fatigue-related errors, and lowering accident risk. This labour saving is valued conservatively in our ROI models, but in practice the reduction in accident liability and associated insurance costs can be substantial.\n\nYield improvement in rice milling is perhaps the most compelling ROI driver for mill owners. Precise whitener pressure control and automated whitening intensity adjustment can improve head rice recovery by one to two percentage points. On a ten-tonne-per-hour mill processing paddy for sixteen hours a day, every one-percentage-point improvement in head rice recovery generates significant additional revenue annually at current market prices.\n\nMaintenance cost reduction is often underestimated in pre-project ROI calculations but frequently exceeds initial projections once automation is installed. Automated monitoring prevents catastrophic failures. A bearing that would previously fail without warning — causing unplanned downtime of six to twelve hours and expensive emergency repairs — is detected weeks in advance by current monitoring. The cost difference between a planned bearing replacement and an emergency breakdown repair, including lost production, is typically a factor of five to eight.\n\nThe typical payback period for a comprehensively designed automation project in a food processing facility, based on our project portfolio of over five hundred installations, is eighteen to thirty months. Partial automation projects targeting specific bottlenecks — a VFD upgrade, a PLC retrofit for one section, a SCADA addition — often achieve payback in ten to fifteen months.\n\nWe provide detailed ROI projections as part of our pre-project engineering consultation at no charge. Our clients consistently tell us that this transparent financial analysis was the factor that built confidence for the investment decision.",
        "automation-roi-milling-industry",
        "business",
        "7 min"
      ),
      (
        "Control Panel Design Best Practices",
        "Inside Teja Controls engineering process: how we take a client brief and deliver a fully tested, certified electrical control panel designed to perform reliably for twenty years or more.",
        "A control panel is the nerve centre of any automated industrial facility. The difference between a panel that performs reliably for twenty years and one that causes constant problems comes down entirely to the quality of the design and manufacturing process. At Teja Controls, we have developed and refined our panel engineering methodology across five hundred projects over fifteen years, and the principles that guide our work are consistent whether the panel is a simple star-delta starter or a multi-feeder MCC for a large processing plant.\n\nOur panel design process begins with a detailed engineering review session with the client. We study the load list, understand the process sequence in depth, identify all interlocking and protection requirements, review the site electrical supply characteristics, and clarify any operational constraints before a single component is specified. This upfront investment in understanding — typically two to four hours of structured discussion — prevents costly changes during manufacturing and eliminates surprises during commissioning.\n\nSchematic design is performed using industry-standard electrical CAD tools. Every circuit is documented to IEC 61439 standards. Every terminal is numbered. Every cable route is planned. Every protection device is sized to the actual load with appropriate derating factors applied for the installation environment. Component selection follows strict quality criteria: Siemens, Schneider Electric, ABB, L&T, and other Tier 1 manufacturers are our default. We use no counterfeit or grey-market components, and we maintain supplier documentation for every project.\n\nPhysical design follows mechanical engineering principles. Cable management is planned before wiring begins. Bus bars are sized for the full prospective short circuit current, not just the rated current. Ventilation calculations determine whether natural convection is adequate or whether forced ventilation with filtration is required. Entry points for cables are planned to allow clean installation and future additions.\n\nAssembly follows a structured, documented process: enclosure preparation and surface treatment verification, busbar installation and torque verification, component mounting per layout drawing, wiring to schematic, ferrule termination on every conductor, and labelling per drawing. Every wire in a Teja Controls panel is ferrule-terminated — no bare wire in terminals, no exceptions. This single practice eliminates the majority of loose-connection faults that cause field failures.\n\nFactory Acceptance Testing is non-negotiable. Before any panel leaves our facility it is powered up and every circuit is tested against the schematic. Protection device operation is verified. Interlocks are function-tested. PLC programmes are loaded and the full control logic is exercised with simulated inputs before site despatch.\n\nSite installation and commissioning are performed by our own engineers, not subcontracted to third parties. We do not consider a project complete until the system has run stably for a commissioning period agreed with the client, all operators have been trained, and the as-built documentation has been handed over. Our after-sales support includes telephone and remote assistance for the life of the installation.",
        "control-panel-design-best-practices",
        "engineering",
        "5 min"
      ),
    ];

    var id = nextId;
    for ((title, excerpt, content, slug, category, readTime) in samples.vals()) {
      posts.add({
        id;
        title;
        excerpt;
        content;
        date = now;
        author = "Teja Controls Engineering Team";
        slug;
        category;
        readTime;
      });
      id += 1;
    };
    id;
  };

  public func getAll(posts : List.List<Types.BlogPost>) : [Types.BlogPost] {
    posts.toArray();
  };

  public func getBySlug(posts : List.List<Types.BlogPost>, slug : Text) : ?Types.BlogPost {
    posts.find(func(p) { p.slug == slug });
  };
  public func getByCategory(posts : List.List<Types.BlogPost>, cat : Text) : [Types.BlogPost] {
    posts.filter(func(p) { p.category == cat }).toArray();
  };
};
